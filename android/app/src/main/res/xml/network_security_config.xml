<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config for CATIE TV Android.
  Allows connections to self-signed certificate servers
  (mirrors allowSelfSigned: true in Starscream/Swift)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
